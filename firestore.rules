rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function profileExists() { return signedIn() && exists(userPath()); }
    function userDoc() { return get(userPath()); }
    function activeUser() { return profileExists() && userDoc().data.active == true; }
    function hasRole(roles) { return activeUser() && userDoc().data.role in roles; }
    function isAdmin() { return hasRole(['owner', 'admin', 'general_manager']); }
    function canOperateFactory() { return hasRole(['owner', 'admin', 'general_manager', 'production_manager', 'warehouse_manager', 'quality_manager', 'shipping_manager']); }
    function canManageStock() { return hasRole(['owner', 'admin', 'general_manager', 'warehouse_manager', 'production_manager']); }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'viewer'
        && request.resource.data.active == false
        && request.resource.data.email == request.auth.token.email;
      allow get: if activeUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /dashboard/{document=**} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /activityLog/{document=**} {
      allow read: if isAdmin();
      allow create: if canOperateFactory();
      allow update, delete: if false;
    }

    match /factoryAlerts/{alertId} {
      allow read: if activeUser();
      allow create, update: if canOperateFactory();
      allow delete: if isAdmin();
    }

    match /products/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['owner', 'admin', 'general_manager', 'production_manager', 'quality_manager']);
    }

    match /recipes/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['owner', 'admin', 'general_manager', 'production_manager', 'quality_manager']);
    }

    match /rawMaterials/{document=**} {
      allow read: if activeUser();
      allow write: if canManageStock();
    }

    match /inventory/{document=**} {
      allow read: if activeUser();
      allow write: if canManageStock();
    }

    match /stockMovements/{movementId} {
      allow read: if activeUser();
      allow create: if canManageStock()
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.type in ['receipt', 'issue'];
      allow update, delete: if false;
    }

    match /productionOrders/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['owner', 'admin', 'general_manager', 'production_manager']);
    }

    match /batches/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['owner', 'admin', 'general_manager', 'production_manager', 'quality_manager']);
    }

    match /qualityInspections/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['owner', 'admin', 'general_manager', 'quality_manager']);
    }

    match /shipments/{document=**} {
      allow read: if activeUser();
      allow write: if hasRole(['owner', 'admin', 'general_manager', 'shipping_manager', 'warehouse_manager']);
    }

    match /system/{document=**} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
